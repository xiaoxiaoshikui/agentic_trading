{
  "name": "mm_deep_btc_v4_p2_p4_p5",
  "output_dir": "experiments/results_mm",
  "split_mode": "rolling",
  "rolling": {
    "min_train_windows": 40,
    "val_windows": 16,
    "test_windows": 12,
    "step_windows": 8
  },
  "dataset": {
    "symbol": "BTCUSDT",
    "interval": "15m",
    "n_bars": 12000,
    "end_time": "2025-12-31T00:00:00Z",
    "cache_dir": "experiments/data_cache",
    "history_glob": ["data/history/*.jsonl", "data/multimodal_history/*.jsonl"],
    "output_dir": "experiments/results_mm",
    "lookback_bars": 64,
    "horizon_bars": 4,
    "max_history_lag_minutes": 180,
    "alignment_mode": "event",
    "require_web_context": true,
    "min_web_context_strength": 0.2,
    "cached_only": false,
    "force_download": false
  },
  "text_encoder": {
    "model_name": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
    "cache_dir": "experiments/mm_cache/text_embeddings"
  },
  "models": [
    {
      "name": "price_tx_d32",
      "kind": "price_sequence_transformer",
      "d_model": 32,
      "n_heads": 4,
      "price_layers": 2,
      "dropout": 0.3,
      "lr": 1e-3,
      "weight_decay": 1e-3,
      "batch_size": 32,
      "epochs": 20,
      "patience": 5,
      "selection_metric": "auc"
    },
    {
      "name": "sacma_lg_mixup",
      "kind": "learned_gate_cross_modal",
      "d_model": 32,
      "n_heads": 4,
      "price_layers": 2,
      "fusion_layers": 1,
      "dropout": 0.4,
      "lag_decay": 0.1,
      "lr": 5e-4,
      "weight_decay": 1e-3,
      "batch_size": 32,
      "epochs": 20,
      "patience": 5,
      "selection_metric": "auc",
      "use_mixup": true,
      "mixup_alpha": 0.4
    },
    {
      "name": "sacma_lg_quality_gate",
      "kind": "learned_gate_cross_modal",
      "d_model": 32,
      "n_heads": 4,
      "price_layers": 2,
      "fusion_layers": 1,
      "dropout": 0.4,
      "lag_decay": 0.1,
      "lr": 5e-4,
      "weight_decay": 1e-3,
      "batch_size": 32,
      "epochs": 20,
      "patience": 5,
      "selection_metric": "auc",
      "use_mixup": true,
      "mixup_alpha": 0.4,
      "use_quality_gate": true
    },
    {
      "name": "sacma_lg_ranking",
      "kind": "learned_gate_cross_modal",
      "d_model": 32,
      "n_heads": 4,
      "price_layers": 2,
      "fusion_layers": 1,
      "dropout": 0.4,
      "lag_decay": 0.1,
      "lr": 5e-4,
      "weight_decay": 1e-3,
      "batch_size": 32,
      "epochs": 20,
      "patience": 5,
      "selection_metric": "auc",
      "use_mixup": true,
      "mixup_alpha": 0.4,
      "use_ranking_loss": true,
      "ranking_margin": 0.1,
      "ranking_weight": 0.3
    },
    {
      "name": "sacma_lg_freeze5",
      "kind": "learned_gate_cross_modal",
      "d_model": 32,
      "n_heads": 4,
      "price_layers": 2,
      "fusion_layers": 1,
      "dropout": 0.4,
      "lag_decay": 0.1,
      "lr": 5e-4,
      "weight_decay": 1e-3,
      "batch_size": 32,
      "epochs": 20,
      "patience": 5,
      "selection_metric": "auc",
      "use_mixup": true,
      "mixup_alpha": 0.4,
      "freeze_text_epochs": 5
    },
    {
      "name": "sacma_lg_p2p4p5",
      "kind": "learned_gate_cross_modal",
      "d_model": 32,
      "n_heads": 4,
      "price_layers": 2,
      "fusion_layers": 1,
      "dropout": 0.4,
      "lag_decay": 0.1,
      "lr": 5e-4,
      "weight_decay": 1e-3,
      "batch_size": 32,
      "epochs": 20,
      "patience": 5,
      "selection_metric": "auc",
      "use_mixup": true,
      "mixup_alpha": 0.4,
      "use_quality_gate": true,
      "use_ranking_loss": true,
      "ranking_margin": 0.1,
      "ranking_weight": 0.3,
      "freeze_text_epochs": 5
    }
  ]
}
