{
  "name": "mm_deep_btc_v5_nonoverlap_source_quality",
  "output_dir": "experiments/results_mm",
  "split_mode": "rolling",
  "rolling": {
    "min_train_windows": 500,
    "val_windows": 200,
    "test_windows": 200,
    "step_windows": 200
  },
  "dataset": {
    "symbol": "BTCUSDT",
    "interval": "15m",
    "n_bars": 40000,
    "end_time": "2025-12-31T00:00:00Z",
    "cache_dir": "experiments/data_cache",
    "history_glob": [
      "data/history/*.jsonl",
      "data/multimodal_history_merged/*.jsonl"
    ],
    "output_dir": "experiments/results_mm",
    "lookback_bars": 64,
    "horizon_bars": 4,
    "max_history_lag_minutes": 60,
    "alignment_mode": "event",
    "require_web_context": true,
    "min_web_context_strength": 0.2,
    "min_text_char_len": 120,
    "min_text_source_count": 4,
    "max_text_error_count": 0,
    "max_text_template_ratio": 0.35,
    "min_text_quality_score": 0.45,
    "cached_only": false,
    "force_download": false
  },
  "text_encoder": {
    "model_name": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
    "cache_dir": "experiments/mm_cache/text_embeddings"
  },
  "models": [
    {
      "name": "source_quality_cond_late",
      "kind": "source_aware_quality_conditional_late_fusion",
      "d_model": 32,
      "n_heads": 4,
      "price_layers": 2,
      "hidden_dim": 128,
      "dropout": 0.3,
      "lr": 1e-3,
      "weight_decay": 1e-3,
      "batch_size": 64,
      "epochs": 30,
      "patience": 7,
      "selection_metric": "auc",
      "use_hybrid_text": true,
      "hybrid_tfidf_features": 128,
      "text_base_dim": 384,
      "context_feature_set": "web_text_aux"
    }
  ]
}
