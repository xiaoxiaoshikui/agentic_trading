{
  "name": "mm_deep_btc_v4_lag",
  "output_dir": "experiments/results_mm",
  "split_mode": "rolling",
  "rolling": {
    "min_train_windows": 40,
    "val_windows": 16,
    "test_windows": 12,
    "step_windows": 8
  },
  "dataset": {
    "symbol": "BTCUSDT",
    "interval": "15m",
    "n_bars": 12000,
    "end_time": "2025-12-31T00:00:00Z",
    "cache_dir": "experiments/data_cache",
    "history_glob": ["data/history/*.jsonl", "data/multimodal_history/*.jsonl"],
    "output_dir": "experiments/mm_cache",
    "lookback_bars": 64,
    "horizon_bars": 4,
    "max_history_lag_minutes": 180,
    "alignment_mode": "event",
    "require_web_context": true,
    "min_web_context_strength": 0.2,
    "cached_only": false,
    "force_download": false
  },
  "text_encoder": {
    "model_name": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
    "cache_dir": "experiments/mm_cache/text_embeddings"
  },
  "models": [
    {
      "name": "sacma_lg_full_lag",
      "kind": "learned_gate_cross_modal",
      "d_model": 32,
      "n_heads": 4,
      "price_layers": 2,
      "fusion_layers": 1,
      "dropout": 0.4,
      "lag_decay": 0.1,
      "lr": 5e-4,
      "weight_decay": 1e-3,
      "batch_size": 32,
      "epochs": 20,
      "patience": 5,
      "selection_metric": "auc",
      "use_mixup": true,
      "mixup_alpha": 0.4
    },
    {
      "name": "sacma_lg_lag_filtered_90",
      "kind": "learned_gate_cross_modal",
      "d_model": 32,
      "n_heads": 4,
      "price_layers": 2,
      "fusion_layers": 1,
      "dropout": 0.4,
      "lag_decay": 0.1,
      "lr": 5e-4,
      "weight_decay": 1e-3,
      "batch_size": 32,
      "epochs": 20,
      "patience": 5,
      "selection_metric": "auc",
      "use_mixup": true,
      "mixup_alpha": 0.4,
      "train_lag_min": 0.0,
      "train_lag_max": 90.0
    },
    {
      "name": "sacma_lg_lag_optimal_30_60",
      "kind": "learned_gate_cross_modal",
      "d_model": 32,
      "n_heads": 4,
      "price_layers": 2,
      "fusion_layers": 1,
      "dropout": 0.4,
      "lag_decay": 0.1,
      "lr": 5e-4,
      "weight_decay": 1e-3,
      "batch_size": 32,
      "epochs": 20,
      "patience": 5,
      "selection_metric": "auc",
      "use_mixup": true,
      "mixup_alpha": 0.4,
      "train_lag_min": 30.0,
      "train_lag_max": 60.0
    },
    {
      "name": "sacma_lg_lag_filtered_hybrid",
      "kind": "learned_gate_cross_modal",
      "d_model": 32,
      "n_heads": 4,
      "price_layers": 2,
      "fusion_layers": 1,
      "dropout": 0.4,
      "lag_decay": 0.1,
      "lr": 5e-4,
      "weight_decay": 1e-3,
      "batch_size": 32,
      "epochs": 30,
      "patience": 8,
      "selection_metric": "auc",
      "use_mixup": true,
      "mixup_alpha": 0.4,
      "train_lag_min": 0.0,
      "train_lag_max": 90.0,
      "lr_schedule": "cosine",
      "use_hybrid_text": true,
      "hybrid_tfidf_features": 50
    }
  ]
}
