{
  "name": "icaif_real_news_costaware_smoke",
  "output_dir": "experiments/results_mm",
  "split_mode": "rolling",
  "transaction_cost_bps": 5.0,
  "export_trade_predictions": true,
  "rolling": {
    "min_train_windows": 500,
    "val_windows": 120,
    "test_windows": 120,
    "step_windows": 10000
  },
  "dataset": {
    "symbol": "BTCUSDT",
    "symbols": ["BTCUSDT", "ETHUSDT", "SOLUSDT"],
    "interval": "15m",
    "n_bars": 10000,
    "end_time": "2026-03-19T23:59:00Z",
    "cache_dir": "experiments/data_cache",
    "history_glob": ["data/multimodal_history_real/*.jsonl"],
    "output_dir": "experiments/results_mm",
    "lookback_bars": 64,
    "horizon_bars": 4,
    "alignment_mode": "event",
    "require_web_context": true,
    "min_web_context_strength": 0.1,
    "min_text_char_len": 80,
    "min_text_source_count": 1,
    "max_text_error_count": 5,
    "max_text_template_ratio": 0.8,
    "min_text_quality_score": 0.0,
    "cached_only": false,
    "force_download": false
  },
  "text_encoder": {
    "model_name": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
    "cache_dir": "experiments/mm_cache/text_embeddings"
  },
  "models": [
    {
      "name": "price_only",
      "kind": "price_sequence_transformer",
      "d_model": 32,
      "n_heads": 4,
      "price_layers": 2,
      "hidden_dim": 128,
      "dropout": 0.3,
      "lr": 1e-3,
      "weight_decay": 1e-3,
      "batch_size": 64,
      "epochs": 2,
      "patience": 1,
      "selection_metric": "auc"
    },
    {
      "name": "dlinear",
      "kind": "dlinear_price",
      "hidden_dim": 128,
      "dropout": 0.2,
      "max_len": 64,
      "lr": 1e-3,
      "weight_decay": 1e-3,
      "batch_size": 64,
      "epochs": 2,
      "patience": 1,
      "selection_metric": "auc"
    },
    {
      "name": "timesnet_lite",
      "kind": "timesnet_lite_price",
      "d_model": 64,
      "hidden_dim": 128,
      "dropout": 0.2,
      "lr": 7e-4,
      "weight_decay": 1e-3,
      "batch_size": 64,
      "epochs": 2,
      "patience": 1,
      "selection_metric": "auc"
    },
    {
      "name": "patchtst",
      "kind": "patchtst_price",
      "d_model": 64,
      "n_heads": 4,
      "price_layers": 2,
      "hidden_dim": 128,
      "dropout": 0.2,
      "patch_len": 16,
      "stride": 8,
      "lr": 7e-4,
      "weight_decay": 1e-3,
      "batch_size": 64,
      "epochs": 2,
      "patience": 1,
      "selection_metric": "auc"
    },
    {
      "name": "itransformer_lite",
      "kind": "itransformer_price",
      "d_model": 64,
      "n_heads": 4,
      "price_layers": 2,
      "hidden_dim": 128,
      "dropout": 0.2,
      "max_len": 64,
      "lr": 7e-4,
      "weight_decay": 1e-3,
      "batch_size": 64,
      "epochs": 2,
      "patience": 1,
      "selection_metric": "auc"
    },
    {
      "name": "text_web_mlp",
      "kind": "text_embedding_mlp",
      "hidden_dim": 128,
      "dropout": 0.3,
      "lr": 1e-3,
      "weight_decay": 1e-3,
      "batch_size": 64,
      "epochs": 2,
      "patience": 1,
      "selection_metric": "auc"
    },
    {
      "name": "price_web",
      "kind": "price_web_late_fusion",
      "d_model": 32,
      "n_heads": 4,
      "price_layers": 2,
      "hidden_dim": 128,
      "dropout": 0.3,
      "lr": 1e-3,
      "weight_decay": 1e-3,
      "batch_size": 64,
      "epochs": 2,
      "patience": 1,
      "selection_metric": "auc"
    },
    {
      "name": "bilstm_fusion",
      "kind": "bilstm_fusion",
      "d_model": 64,
      "hidden_dim": 128,
      "dropout": 0.25,
      "lr": 7e-4,
      "weight_decay": 1e-3,
      "batch_size": 64,
      "epochs": 2,
      "patience": 1,
      "selection_metric": "auc"
    },
    {
      "name": "early_fusion",
      "kind": "early_fusion",
      "d_model": 48,
      "n_heads": 4,
      "price_layers": 2,
      "hidden_dim": 128,
      "dropout": 0.3,
      "lr": 7e-4,
      "weight_decay": 1e-3,
      "batch_size": 64,
      "epochs": 2,
      "patience": 1,
      "selection_metric": "auc"
    },
    {
      "name": "cgcma",
      "kind": "conditionally_gated_cross_modal",
      "d_model": 32,
      "n_heads": 4,
      "price_layers": 2,
      "hidden_dim": 128,
      "dropout": 0.3,
      "lr": 1e-3,
      "weight_decay": 1e-3,
      "batch_size": 64,
      "epochs": 2,
      "patience": 1,
      "selection_metric": "auc",
      "export_gate_analysis": true
    }
  ]
}
