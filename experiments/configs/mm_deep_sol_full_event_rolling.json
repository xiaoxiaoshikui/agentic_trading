{
  "name": "mm_deep_sol_full_event_rolling",
  "output_dir": "experiments/results_mm",
  "split_mode": "rolling",
  "rolling": {
    "min_train_windows": 120,
    "val_windows": 48,
    "test_windows": 24,
    "step_windows": 24
  },
  "dataset": {
    "symbol": "SOLUSDT",
    "interval": "15m",
    "n_bars": 12000,
    "end_time": "2025-12-31T00:00:00Z",
    "cache_dir": "experiments/data_cache",
    "history_glob": ["data/history/*.jsonl", "data/multimodal_history/*.jsonl"],
    "output_dir": "experiments/mm_cache",
    "lookback_bars": 64,
    "horizon_bars": 4,
    "max_history_lag_minutes": 180,
    "alignment_mode": "event",
    "require_web_context": true,
    "cached_only": false,
    "force_download": true
  },
  "text_encoder": {
    "model_name": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
    "cache_dir": "experiments/mm_cache/text_embeddings"
  },
  "models": [
    {
      "name": "price_sequence_transformer",
      "kind": "price_sequence_transformer",
      "d_model": 96,
      "n_heads": 4,
      "price_layers": 2,
      "dropout": 0.1,
      "lr": 0.001,
      "weight_decay": 0.0001,
      "batch_size": 64,
      "epochs": 12,
      "patience": 4
    },
    {
      "name": "text_embedding_mlp",
      "kind": "text_embedding_mlp",
      "hidden_dim": 192,
      "dropout": 0.1,
      "lr": 0.001,
      "weight_decay": 0.0001,
      "batch_size": 64,
      "epochs": 12,
      "patience": 4
    },
    {
      "name": "cross_modal_attention",
      "kind": "cross_modal_attention",
      "d_model": 96,
      "n_heads": 4,
      "price_layers": 2,
      "fusion_layers": 1,
      "dropout": 0.1,
      "lr": 0.001,
      "weight_decay": 0.0001,
      "batch_size": 64,
      "epochs": 12,
      "patience": 4
    }
  ]
}
