# Copy this file to .env and replace placeholders with real values.
# Never commit .env or real API credentials.

# Binance USDT-M Futures
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
BINANCE_TESTNET=true

# Safety defaults
DRY_RUN=true
LOG_LEVEL=INFO
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=15m
MAX_LEVERAGE=5
RISK_PER_TRADE=0.01

# LLM integration
ENABLE_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Optional OpenAI-compatible providers
# Leave unused providers blank. The app uses the first non-empty key in
# OPENAI_API_KEY, DEEPSEEK_API_KEY, then LLM_API_KEY order.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_API_BASE=
LLM_API_KEY=
LLM_MODEL=
LLM_API_BASE=
